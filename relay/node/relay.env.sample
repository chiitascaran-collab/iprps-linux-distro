# IPRPS Link relay settings. Copy to relay.env (beside relay.js) and edit.
PORT=8787
BIND=127.0.0.1
# The address players use, without a trailing slash. A folder is fine: https://example.com/play
PUBLIC_URL=https://play.example.com
# Infinite Plane usernames or emails allowed to connect a table. Empty: the first account that connects owns the relay.
OWNERS=
AUTH_URL=https://infiniteplane.space/auth/
# 1 when Caddy/nginx is in front (it is, with the settings above)
TRUST_PROXY=1
# To serve HTTPS without a web server in front instead: BIND=0.0.0.0, PORT=443 and
# TLS_CERT=/etc/letsencrypt/live/play.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/play.example.com/privkey.pem
