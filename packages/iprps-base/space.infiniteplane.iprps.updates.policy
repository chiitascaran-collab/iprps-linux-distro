<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>IPRPS OS</vendor>
  <vendor_url>https://infiniteplane.space/</vendor_url>
  <action id="space.infiniteplane.iprps.updates">
    <description>Install updates and software</description>
    <message>IPRPS Updates needs an administrator's password to install updates and software.</message>
    <icon_name>iprps-updates</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/iprps/updates/iprps-updates-server</annotate>
  </action>
</policyconfig>
