[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/icons/*

[Action]
Description = Updating the icon caches...
When = PostTransaction
Exec = /bin/sh -c 'for t in hicolor IPRPS; do [ -f /usr/share/icons/$t/index.theme ] && gtk-update-icon-cache --quiet --force /usr/share/icons/$t; done; true'
